# ─── Moyasar (Saudi Payment Gateway) ───────────────────────────────────────
# Get your keys from: https://dashboard.moyasar.com
# Use TEST keys for development, LIVE keys for production

MOYASAR_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Site URL ───────────────────────────────────────────────────────────────
# In development: http://localhost:3000
# In production: your actual domain (e.g. https://seedaal.com)

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Email (Optional — for sending download links after purchase) ────────────
# Recommended: Resend.com (free tier: 3,000 emails/month)
# Get API key from: https://resend.com

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@seedaal.com
